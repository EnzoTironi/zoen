{
  "name": "zoen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "build:core": "tsc --build packages/contracts/tsconfig.build.json packages/authority/tsconfig.build.json",
    "build:apps": "tsc --build apps/server/tsconfig.build.json apps/cli/tsconfig.build.json",
    "start:server": "node --env-file=.env.application apps/server/dist/main.js",
    "cli": "node apps/cli/dist/main.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file=.env.infra node_modules/vitest/vitest.mjs run --project integration",
    "test:components": "playwright test",
    "build:web": "vite build --config vite.application.config.ts",
    "build": "pnpm build:apps && pnpm build:web && python3 tooling/build_release.py",
    "provision:local": "node --env-file=.env.infra ops/local/provision.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@cloudflare/workers-types": "5.20260905.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/tsgo": "0.41.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "bun-types": "1.4.1",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.8",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0"
}
