{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ]
  },
  "include": [
    "apps/edge/src/app.ts",
    "apps/edge/src/main.ts",
    "packages/adapters/src/cedar.ts",
    "packages/adapters/src/config.ts",
    "packages/adapters/src/cryptography.ts",
    "packages/adapters/src/http-security.ts",
    "packages/adapters/src/pg.ts",
    "packages/adapters/src/s3.ts",
    "packages/adapters/src/semantic-http.ts",
    "packages/clients/src/cli.ts",
    "packages/clients/src/semantic-client.ts",
    "packages/contracts/src/ports.ts",
    "packages/contracts/src/semantic.ts",
    "packages/door/src/door.ts",
    "packages/kernel/src/decimal.ts",
    "packages/kernel/src/graph.ts",
    "packages/kernel/src/ids.ts",
    "packages/kernel/src/json.ts",
    "packages/kernel/src/result.ts",
    "packages/kernel/src/time.ts",
    "packages/ontology/src/apps/manifest.ts",
    "packages/ontology/src/apps/session-constraints.ts",
    "packages/ontology/src/authority/guards.ts",
    "packages/ontology/src/authority/outbox.ts",
    "packages/ontology/src/authority/states.ts",
    "packages/ontology/src/authority/transaction.ts",
    "packages/ontology/src/definitions/expression.ts",
    "packages/ontology/src/interpretation/claims.ts",
    "packages/ontology/src/interpretation/reconcile.ts",
    "packages/ontology/src/surfaces/dispatch.ts",
    "packages/ontology/src/surfaces/registry.ts"
  ]
}
