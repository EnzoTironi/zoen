{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@zoen/contracts/*": ["./packages/contracts/src/*.ts"],
      "@zoen/ontology/*": ["./packages/ontology/src/*.ts"]
    },
    "jsx": "react-jsx",
    "types": ["node", "bun-types/sqlite"],
    "skipLibCheck": false
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "tooling/**/*.ts",
    "ops/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "reference",
    "archives",
    "ops/alchemy/**",
    "ops/alchemy/**/*.ts"
  ]
}
