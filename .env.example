# Real services only. Never commit your populated .env file.
# This candidate binds loopback; public hosting is not admitted.
ZOEN_PUBLIC_ORIGIN=http://127.0.0.1:3080
ZOEN_PORT=3080
ZOEN_AUTHORITY_DATABASE_URL=
ZOEN_DOOR_DATABASE_URL=
ZOEN_OUTBOX_DATABASE_URL=
ZOEN_MIGRATOR_DATABASE_URL=
BETTER_AUTH_SECRET=
AWS_REGION=
ZOEN_EVIDENCE_BUCKET=
ZOEN_BUCKET_OWNER=
# Prefer an AWS profile/workload identity, not access keys in this file.
AWS_PROFILE=
# Review the target before granting these explicit operator permissions:
ZOEN_ALLOW_SCHEMA_MIGRATIONS=
ZOEN_ALLOW_ROLE_PROVISIONING=
ZOEN_AUTHORITY_PASSWORD=
ZOEN_DOOR_PASSWORD=
ZOEN_OUTBOX_PASSWORD=
# Set only against dedicated disposable resources for real qualification:
ZOEN_REAL_TEST_CONSENT=
