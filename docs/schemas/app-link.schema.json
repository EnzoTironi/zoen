{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "linkRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "worldRef": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "format": "uuid"
        },
        "realm": {
          "enum": [
            "live",
            "evaluation"
          ]
        }
      },
      "required": [
        "worldId",
        "realm"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "focus",
            "app"
          ]
        },
        "ref": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "versionPolicy": {
      "enum": [
        "current",
        "pinned"
      ]
    },
    "pinnedManifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipientConstraint": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "linkRef",
    "worldRef",
    "target",
    "versionPolicy",
    "recipientConstraint",
    "expiresAt",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.invalid/execution/app-link.schema.json",
  "description": "Server-side record. Possession is not authority; fields are not an unauthenticated write API.",
  "allOf": [
    {
      "if": {
        "properties": {
          "versionPolicy": {
            "const": "pinned"
          }
        }
      },
      "then": {
        "required": [
          "pinnedManifestDigest"
        ]
      },
      "else": {
        "not": {
          "required": [
            "pinnedManifestDigest"
          ]
        }
      }
    }
  ]
}
