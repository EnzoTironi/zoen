{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.invalid/execution/operation-envelope.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "worldRef": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "format": "uuid"
        },
        "realm": {
          "enum": [
            "live",
            "evaluation"
          ]
        }
      },
      "required": [
        "worldId",
        "realm"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "expectedBasis": {
      "type": "object"
    },
    "input": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "operationId",
    "worldRef",
    "purpose",
    "input"
  ],
  "additionalProperties": false
}
