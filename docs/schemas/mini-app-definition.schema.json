{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "appId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "rendererVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "enum": [
        "declarative",
        "executable-view",
        "specialized-backend"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        },
        "required": [
          "id",
          "label",
          "components"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "input": {
            "type": "object"
          },
          "resultPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "read",
              "action"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "requestedOperations": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxSubplans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxPageRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      },
      "required": [
        "maxNodes",
        "maxDepth",
        "maxSubplans",
        "maxPageRows",
        "maxResponseBytes"
      ],
      "additionalProperties": false
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "appId",
    "title",
    "rendererVersion",
    "mode",
    "pages",
    "bindings",
    "requestedOperations",
    "budgets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.invalid/execution/mini-app-definition.schema.json",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "text",
            "table",
            "board",
            "metric",
            "timeline",
            "form"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "children": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "declarative"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "artifactDigest"
          ]
        }
      },
      "else": {
        "required": [
          "artifactDigest"
        ]
      }
    }
  ]
}
