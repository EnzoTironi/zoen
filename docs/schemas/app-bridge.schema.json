{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "zoen.app-bridge.v1"
    },
    "kind": {
      "const": "semantic.call"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "channelNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "call": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "worldRef": {
          "type": "object",
          "properties": {
            "worldId": {
              "type": "string",
              "format": "uuid"
            },
            "realm": {
              "enum": [
                "live",
                "evaluation"
              ]
            }
          },
          "required": [
            "worldId",
            "realm"
          ],
          "additionalProperties": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "expectedBasis": {
          "type": "object"
        },
        "input": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "worldRef",
        "purpose",
        "input"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "kind",
    "requestId",
    "channelNonce",
    "manifestDigest",
    "call"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.invalid/execution/app-bridge.schema.json",
  "description": "A message shape only. Host must verify sourceWindow/exact origin, channel nonce and current session; operation input uses its released schema."
}
