{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.invalid/execution/state-machine.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "initial": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "type": "string",
            "minLength": 1
          },
          "atomic_effect": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "event",
          "to",
          "guard",
          "atomic_effect"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "owner",
    "initial",
    "states",
    "transitions",
    "notes"
  ],
  "additionalProperties": false
}
