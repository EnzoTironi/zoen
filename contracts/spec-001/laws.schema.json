{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.local/contracts/spec-001/laws.schema.json",
  "title": "SPEC-001 algebraic law suite report",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed", "casesPerLaw", "executed", "passed", "failed", "digest"],
  "properties": {
    "seed": { "type": "string", "minLength": 1, "maxLength": 128 },
    "casesPerLaw": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "executed": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locale": { "type": "string" },
    "timezone": { "type": "string" }
  }
}
