{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.local/contracts/spec-001/ids.schema.json",
  "title": "SPEC-001 branded IDs and realm-safe WorldRef / live-only Action",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "realm": {
      "type": "string",
      "enum": ["live", "evaluation"]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "maxLength": 19
    },
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "worldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldId", "realm"],
      "properties": {
        "worldId": { "$ref": "#/$defs/uuid" },
        "realm": { "$ref": "#/$defs/realm" }
      }
    },
    "liveOnlyActionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldRef", "operation", "operationId"],
      "properties": {
        "worldRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worldId", "realm"],
          "properties": {
            "worldId": { "$ref": "#/$defs/uuid" },
            "realm": { "const": "live" }
          }
        },
        "operation": { "$ref": "#/$defs/semanticId" },
        "operationId": { "$ref": "#/$defs/uuid" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/worldRef" },
    { "$ref": "#/$defs/liveOnlyActionInput" }
  ]
}
