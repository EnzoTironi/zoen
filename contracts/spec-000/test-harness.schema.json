{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.local/contracts/spec-000/test-harness.schema.json",
  "title": "SPEC-000 test harness run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ticket", "spec", "profile", "ok", "executedCount", "skippedCount", "seed"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "spec-000.test-harness.v1" },
    "ticket": { "type": "string", "const": "ZN-0004" },
    "spec": { "type": "string", "const": "SPEC-000" },
    "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "type": "boolean" },
    "kind": { "type": "string", "enum": ["MissingPrerequisite"] },
    "missing": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
    "skipped": { "type": "boolean", "const": false },
    "executedCount": { "type": "integer", "minimum": 0 },
    "skippedCount": { "type": "integer", "const": 0 },
    "seed": { "type": "string", "minLength": 1, "maxLength": 128 },
    "logs": { "type": "array", "items": { "type": "string" }, "maxItems": 256 },
    "dependencyVersions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "disabledRoute": { "type": "string", "maxLength": 256 }
  }
}
