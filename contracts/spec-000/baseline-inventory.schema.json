{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.local/contracts/spec-000/baseline-inventory.schema.json",
  "title": "SPEC-000 baseline inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticket",
    "spec",
    "writeCredentialsUsed",
    "repositories",
    "hashedPackages",
    "components",
    "liveDataPreservation",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "spec-000.baseline-inventory.v1"
    },
    "ticket": {
      "type": "string",
      "const": "ZN-0001"
    },
    "spec": {
      "type": "string",
      "const": "SPEC-000"
    },
    "writeCredentialsUsed": {
      "type": "boolean",
      "const": false
    },
    "producedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "role",
          "ref",
          "commit",
          "license",
          "rootManifests",
          "unchangedVerification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "enum": [
              "read-only-migration-source",
              "implementation-target"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "observed",
                  "observed-with-conflict",
                  "absent"
                ]
              },
              "file": {
                "type": ["string", "null"],
                "maxLength": 128
              },
              "spdxObserved": {
                "type": ["string", "null"],
                "maxLength": 64
              },
              "cargoTomlLicense": {
                "type": ["string", "null"],
                "maxLength": 64
              },
              "sha256": {
                "type": ["string", "null"],
                "pattern": "^([0-9a-f]{64})?$"
              },
              "notes": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          "rootManifests": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "package.json": {
                "type": "object",
                "additionalProperties": true
              },
              "Cargo.toml": {
                "type": "object",
                "additionalProperties": true
              },
              "README.md": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "unchangedVerification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "preCommit", "postCommit", "matched"],
            "properties": {
              "method": {
                "type": "string",
                "const": "git-ls-remote"
              },
              "preCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "postCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "matched": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "hashedPackages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "label", "sha256", "bytes"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sourceLedger": {
            "type": "string",
            "maxLength": 256
          },
          "expectedSha256FromLedger": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRepository",
          "path",
          "pathKind",
          "classification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceRepository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "classification": {
            "type": "string",
            "enum": ["import", "rewrite", "discard"]
          },
          "pathKind": {
            "type": "string",
            "enum": ["repository-path", "conceptual-label", "archive-path"],
            "description": "For conceptual-label, path preserves an earlier category label and does not assert a real repository location or observed reuse evidence."
          },
          "evidence": {
            "type": "string",
            "enum": ["present", "absent"]
          },
          "rationale": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "liveDataPreservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "inventory",
        "tenantsVerified",
        "ownerSupplyRequired",
        "osDeploymentResetForbidden"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "unresolved"
        },
        "inventory": {
          "type": "string",
          "const": "unknown"
        },
        "tenantsVerified": {
          "type": "boolean",
          "const": false
        },
        "ownerSupplyRequired": {
          "type": "boolean",
          "const": true
        },
        "osDeploymentResetForbidden": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "profile", "fixtureSeed"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "profile": {
          "type": "string",
          "const": "admission-read-only"
        },
        "fixtureSeed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
