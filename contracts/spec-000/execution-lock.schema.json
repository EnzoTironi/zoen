{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoen.local/contracts/spec-000/execution-lock.schema.json",
  "title": "SPEC-000 execution lock (core toolchain admission)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticket",
    "spec",
    "admissionStatus",
    "profile",
    "producedAt",
    "toolchain",
    "compatibilityProbes",
    "cleanInstalls",
    "environment",
    "observations",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "spec-000.execution-lock.v1"
    },
    "ticket": {
      "type": "string",
      "const": "ZN-0002"
    },
    "spec": {
      "type": "string",
      "const": "SPEC-000"
    },
    "admissionStatus": {
      "type": "string",
      "enum": ["AdmittedLock", "BLOCKED"]
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "disabledRoute": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "pnpm",
        "typescript",
        "hono",
        "pg",
        "postgresql",
        "cedarBinding",
        "schemaValidator",
        "canonicalizer",
        "testTools",
        "images"
      ],
      "properties": {
        "node": { "$ref": "#/$defs/runtimeComponent" },
        "pnpm": { "$ref": "#/$defs/npmComponent" },
        "typescript": { "$ref": "#/$defs/npmComponent" },
        "hono": { "$ref": "#/$defs/npmComponent" },
        "honoNodeServer": { "$ref": "#/$defs/npmComponent" },
        "pg": { "$ref": "#/$defs/npmComponent" },
        "postgresql": { "$ref": "#/$defs/imageComponent" },
        "cedarBinding": { "$ref": "#/$defs/npmComponent" },
        "schemaValidator": { "$ref": "#/$defs/familyOrPackage" },
        "canonicalizer": { "$ref": "#/$defs/familyOrPackage" },
        "testTools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entries"],
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/familyOrPackage" }
            }
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/imageComponent" }
        }
      }
    },
    "compatibilityProbes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "honoStreaming",
        "pgTransaction",
        "cedarDeny",
        "schemaCanonicalizer"
      ],
      "properties": {
        "honoStreaming": { "$ref": "#/$defs/probeResult" },
        "pgTransaction": { "$ref": "#/$defs/probeResult" },
        "cedarDeny": { "$ref": "#/$defs/probeResult" },
        "schemaCanonicalizer": { "$ref": "#/$defs/probeResult" }
      }
    },
    "cleanInstalls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "runs", "identicalIntegrity"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "resolvedCount", "integrityDigest"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "resolvedCount": { "type": "integer", "minimum": 0 },
              "integrityDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "identicalIntegrity": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localNodeVersion",
        "requiredNodeRange",
        "nodeRangeSatisfied",
        "pnpmAvailable",
        "platform",
        "arch"
      ],
      "properties": {
        "localNodeVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "requiredNodeRange": { "type": "string", "minLength": 1, "maxLength": 32 },
        "nodeRangeSatisfied": { "type": "boolean" },
        "pnpmAvailable": { "type": "boolean" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 256 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "fixtureSeed", "profile"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "fixtureSeed": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "component": { "type": "string", "maxLength": 128 }
        }
      }
    }
  },
  "$defs": {
    "integrity": {
      "type": "string",
      "pattern": "^sha(256|512)-[A-Za-z0-9+/=]+$"
    },
    "sha256hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "npmComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["resolved", "BLOCKED", "unresolved"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "integrity": { "$ref": "#/$defs/integrity" },
        "shasum": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tarball": { "type": "string", "maxLength": 512 },
        "license": { "type": ["string", "null"], "maxLength": 64 },
        "family": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    },
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "status", "source"],
      "properties": {
        "family": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["resolved", "BLOCKED", "unresolved"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ltsCodename": { "type": ["string", "null"], "maxLength": 64 },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256"],
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 256 },
              "sha256": { "$ref": "#/$defs/sha256hex" }
            }
          }
        },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    },
    "imageComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tag", "status", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tag": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["resolved", "BLOCKED", "unresolved"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "indexDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platformDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "localRepoDigest": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "family": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    },
    "familyOrPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "status", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "family": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": {
          "type": "string",
          "enum": ["resolved", "BLOCKED", "unresolved"]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": ["string", "null"], "maxLength": 128 },
        "version": { "type": ["string", "null"], "maxLength": 64 },
        "integrity": {
          "type": ["string", "null"],
          "pattern": "^(sha(256|512)-[A-Za-z0-9+/=]+)?$"
        },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    },
    "probeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED"]
        },
        "observed": { "type": ["string", "null"], "maxLength": 1024 },
        "reason": { "type": ["string", "null"], "maxLength": 1024 },
        "error": { "type": ["string", "null"], "maxLength": 2048 }
      }
    }
  }
}
